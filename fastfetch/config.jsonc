{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "padding": {
      "left": 1,
      "right": 1,
    },
    "height": 20,
    "source": "~/.config/fastfetch/rei.png"
  },
  "display": {
    "size": {
      "binaryPrefix": "si",
      "ndigits": 1
    },
    "separator": " |  ",
    "color": {
      "keys": "blue",
      "title": "blue"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#1;blue}SkyNixty@X712{#}"
    },
    {
      "type": "custom",
      "format": "─────────────────────────────────",
    },
    {
      "type": "os",
      "key": "OS      ",
      "format": "{name} {version-id}"
    },
    {
      "type": "host",
      "key": "PC      ",
      "format": "VivoBook 17 (X712)"
    },
    {
      "type": "kernel",
      "format": "{release}",
      "key": "KERNEL  "
    },
    {
      "type": "packages",
      "key": "PKGS    ",
      "format": "{all}"
    },
    {
      "type": "de",
      "key": "DE      ",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "format": "{pretty-name}",
      "key": "TERMINAL"
    },
    {
      "type": "custom",
      "format": "─────────────────────────────────",
    },
    {
      "type": "uptime",
      "key": "UPTIME  "
    },
    {
      "type": "cpu",
      "key": "CPU     ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU     ",
      "format": "AMD Radeon Vega 8"
    },
    {
      "type": "memory",
      "key": "RAM     ",
      "format": "{used<8} / {total>8}"
    },
    {
      "type": "swap",
      "key": "SWAP    ",
      "format": "{used<8} / {total>8}"
    },
    {
      "type": "disk",
      "key": "DISK (/)",
      "format": "{size-used<8} / {size-total>8}"
    },
    {
      "type": "custom",
      "format": "─────────────────────────────────",
    },
    {
      "type": "wifi",
      "key": "WIFI    ",
      "format": "{ssid}"
    },
    {
      "type": "localip",
      "key": "LAN     ",
      "format": ""
    },
    {
      "type": "custom",
      "format": "─────────────────────────────────"
    },
    {
      "type": "custom",
      "format": "{#1;blue}MSG{#}      |  I LOVE REI!1!!1!!!!"
    },
    {
      "type": "custom",
      "format": "─────────────────────────────────"
    },
  ]
}
